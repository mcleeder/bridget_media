# systemd unit for the Pi Media podcast player.
# @USER@ and @APP_DIR@ are filled in by setup_pi.sh.

[Unit]
Description=Pi Media podcast player
After=network-online.target mpd.service
Wants=network-online.target
# A wiring/hardware fault is not something retrying fixes, so give up after 5
# attempts and sit in "failed" — which `systemctl status pi-media` reports
# plainly — instead of looping every RestartSec forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
# DB_PATH in config.py is relative, so the working directory determines
# where pi_media.db lives.
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=5

# Lighter-touch hardening than pi-media-feeds gets: this unit drives SPI, I2C
# and GPIO, and shells out to setuid sudo for rfkill and configure-speaker, so
# NoNewPrivileges and ProtectSystem=strict would both break it.
ProtectSystem=full
# ProtectSystem=full mounts /etc read-only for this unit *and every child it
# spawns* — sudo included. Switching speakers therefore failed silently at the
# configure-speaker step (GNU sed exits 4 on the I/O error), leaving MPD
# pointed at the previous device: the speaker connected audibly and then
# played nothing. This is the one file the app legitimately rewrites.
ReadWritePaths=/etc/mpd.conf
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
